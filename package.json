{
  "name": "medical-camp-registration-root",
  "private": true,
  "version": "1.0.0",
  "description": "Medical Camp Registration Portal Root",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
